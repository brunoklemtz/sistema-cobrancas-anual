{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "https://site-klemtz.vercel.app/admin/cobrancas",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://site-klemtz.vercel.app/admin/cobrancas",
      "permanent": false
    }
  ]
}
